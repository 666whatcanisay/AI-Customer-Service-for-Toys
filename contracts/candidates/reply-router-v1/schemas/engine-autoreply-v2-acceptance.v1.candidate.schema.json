  "title": "EngineAutoreplyV2AcceptanceV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-cs:candidate:engine-autoreply-v2-acceptance.v1.candidate",
