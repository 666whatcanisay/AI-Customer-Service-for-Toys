      "type": "string"
    },
    "engine_commit": {
      "pattern": "^[a-f0-9]{40,64}$",
      "title": "Engine Commit",
      "type": "string"
    },
    "candidate_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Manifest Sha256",
      "type": "string"
    },
    "gateway_wire": {
      "const": "1.0",
      "title": "Gateway Wire",
      "type": "string"
    },
    "gateway_raw_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Gateway Raw Sha256",
      "type": "string"
    },
    "gateway_canonical_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Gateway Canonical Sha256",
      "type": "string"
    },
    "contract_status": {
      "const": "UNCOORDINATED_CANDIDATE",
      "title": "Contract Status",
      "type": "string"
    },
    "checks": {
      "additionalProperties": {
        "$ref": "#/$defs/EngineAutoreplyCheckV1"
      },
      "title": "Checks",
      "type": "object"
    },
    "side_effects": {
      "$ref": "#/$defs/EngineAutoreplySideEffectsV1"
    },
    "contains_secret_material": {
      "title": "Contains Secret Material",
      "type": "boolean"
    },
    "contains_customer_data": {
      "title": "Contains Customer Data",
      "type": "boolean"
    },
    "final_status": {
      "$ref": "#/$defs/EngineAutoreplyAcceptanceStatus"
    }
  },
  "required": [
    "schema_version",
    "engine_commit",
    "candidate_manifest_sha256",
    "gateway_wire",
    "gateway_raw_sha256",
    "gateway_canonical_sha256",
    "contract_status",
    "checks",
    "side_effects",
    "contains_secret_material",
    "contains_customer_data",
    "final_status"
