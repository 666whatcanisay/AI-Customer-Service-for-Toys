        "status": {
          "$ref": "#/$defs/EngineAutoreplyAcceptanceStatus"
        },
        "evidence_codes": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Codes",
          "type": "array"
        }
      },
      "required": [
        "status",
        "evidence_codes"
      ],
      "title": "EngineAutoreplyCheckV1",
      "type": "object"
    },
    "EngineAutoreplySideEffectsV1": {
      "additionalProperties": false,
      "properties": {
        "engine_source_modified": {
          "title": "Engine Source Modified",
          "type": "boolean"
        },
        "runtime_started": {
          "title": "Runtime Started",
          "type": "boolean"
        },
        "pdd_connected": {
          "title": "Pdd Connected",
          "type": "boolean"
        },
        "real_send_attempted": {
          "title": "Real Send Attempted",
          "type": "boolean"
        }
      },
      "required": [
        "engine_source_modified",
        "runtime_started",
        "pdd_connected",
        "real_send_attempted"
      ],
      "title": "EngineAutoreplySideEffectsV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Engine-owned test artifact consumed only by the Card 6 verifier.",
  "properties": {
