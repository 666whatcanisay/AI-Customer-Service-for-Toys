      "title": "ReplyReadinessScopeV1",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "VerifiedProductContext": {
      "additionalProperties": false,
      "properties": {
        "product_reference": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Reference"
        },
        "product_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Name"
        },
        "sku_reference": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku Reference"
        },
        "sku_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku Name"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "title": "VerifiedProductContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pdd-reply-readiness-input.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "test_data_mode": {
      "const": true,
      "title": "Test Data Mode",
      "type": "boolean"
    },
    "production_usable": {
      "const": false,
      "title": "Production Usable",
      "type": "boolean"
    },
    "allow_auto_send": {
      "const": false,
      "title": "Allow Auto Send",
      "type": "boolean"
    },
    "execution_mode": {
      "$ref": "#/$defs/ReplyReadinessExecutionMode",
      "default": "READINESS_SANDBOX"
    },
    "scope": {
      "$ref": "#/$defs/ReplyReadinessScopeV1"
    },
    "question_set": {
      "$ref": "#/$defs/PddQuestionSetProjection"
    },
    "knowledge_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplyReadinessKnowledgeSnapshotV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "knowledge_sources": {
      "items": {
        "$ref": "#/$defs/ReplyReadinessKnowledgeSnapshotV1"
      },
      "maxItems": 64,
      "title": "Knowledge Sources",
      "type": "array"
    },
    "reply_rule_snapshot_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply Rule Snapshot Revision"
    },
    "reply_rule_snapshot_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply Rule Snapshot Fingerprint"
    },
    "router_build_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Router Build Fingerprint",
      "type": "string"
    },
    "sandbox_vector_identity": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^in-memory-replay:",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sandbox Vector Identity"
    },
    "publication_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplyReadinessPublicationStateV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
