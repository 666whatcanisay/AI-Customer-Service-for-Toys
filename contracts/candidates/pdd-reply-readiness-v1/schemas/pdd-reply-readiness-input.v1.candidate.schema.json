    "verified_product": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifiedProductContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "test_data_mode",
    "production_usable",
    "allow_auto_send",
    "scope",
    "question_set",
    "router_build_fingerprint"
  ],
  "title": "PddReplyReadinessInputV1",
  "type": "object",
  "x-ai-cs-contract-status": "UNCOORDINATED_CANDIDATE",
  "x-ai-cs-contract-type": "PddReplyReadinessInputV1"
}
