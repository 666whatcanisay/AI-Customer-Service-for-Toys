{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-product-knowledge-visibility.v1.schema.json",
  "title": "AI Product Knowledge Visibility V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "ai-product-knowledge-visibility.v1"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "status": {"enum": ["NOT_GENERATED", "GENERATING", "PUBLISHED", "SYNC_FAILED", "NEED_RESYNC"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "status", "current_fingerprint", "indexed_fingerprint", "active_collection", "chunk_count", "embedding_count"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"$ref": "#/$defs/status"},
        "current_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "indexed_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "active_collection": {"type": ["string", "null"], "maxLength": 128},
        "chunk_count": {"type": "integer", "minimum": 0},
        "embedding_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
