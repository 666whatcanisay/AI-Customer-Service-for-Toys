{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cs.local/contracts/store-context-resolver.v1.schema.json",
  "title": "AI-CS Store Context Resolver V1",
  "description": "C-owned Store selection, conversation Product/SKU resolution, and minimized resolution-audit objects.",
  "$defs": {
    "ResolutionStatus": {
      "type": "string",
      "enum": ["RESOLVED", "STORE_SELECTION_REQUIRED", "PRODUCT_CONFIRMATION_REQUIRED", "SKU_CONFIRMATION_REQUIRED", "UNKNOWN"]
    },
    "Store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "tenant_id", "platform", "store_code", "store_name", "is_default"],
      "properties": {
        "store_id": { "type": "integer", "minimum": 1 },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
        "store_code": { "type": "string", "minLength": 1, "maxLength": 96 },
        "store_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "is_default": { "type": "boolean" }
      }
    },
    "ProductCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "display_name"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "SkuCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id", "display_name"],
      "properties": {
        "sku_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "DefaultStoreRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id"],
      "properties": { "store_id": { "type": "integer", "minimum": 1 } }
    },
    "WorkspaceContextResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "user_id", "roles", "all_store_access", "state", "stores", "effective_store"],
      "properties": {
        "schema_version": { "const": "ai-cs.store-context.v1" },
        "user_id": { "type": "string", "format": "uuid" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ADMIN", "OPERATOR", "CUSTOMER_SERVICE"] } },
        "all_store_access": { "type": "boolean" },
        "state": { "enum": ["READY", "STORE_SELECTION_REQUIRED"] },
        "stores": { "type": "array", "items": { "$ref": "#/$defs/Store" } },
        "effective_store": { "oneOf": [{ "$ref": "#/$defs/Store" }, { "type": "null" }] }
      }
    },
    "ConversationMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["CUSTOMER", "AGENT"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "ResolutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation"],
      "properties": {
        "conversation": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/ConversationMessage" } },
        "store_id": { "type": ["integer", "null"], "minimum": 1 },
        "confirmed_product_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "confirmed_sku_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
      }
    },
    "ResolutionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "resolution_id", "status", "store", "product", "sku", "product_candidates", "sku_candidates", "reason_code", "created_at"],
      "properties": {
        "schema_version": { "const": "ai-cs.store-context.v1" },
        "resolution_id": { "type": "string", "format": "uuid" },
        "status": { "$ref": "#/$defs/ResolutionStatus" },
        "store": { "oneOf": [{ "$ref": "#/$defs/Store" }, { "type": "null" }] },
        "product": { "oneOf": [{ "$ref": "#/$defs/ProductCandidate" }, { "type": "null" }] },
        "sku": { "oneOf": [{ "$ref": "#/$defs/SkuCandidate" }, { "type": "null" }] },
        "product_candidates": { "type": "array", "items": { "$ref": "#/$defs/ProductCandidate" } },
        "sku_candidates": { "type": "array", "items": { "$ref": "#/$defs/SkuCandidate" } },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ResolutionAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_id", "user_id", "store_id", "status", "product_id", "sku_id", "product_candidate_ids", "sku_candidate_ids", "reason_code", "created_at"],
      "properties": {
        "resolution_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "store_id": { "type": ["integer", "null"], "minimum": 1 },
        "status": { "$ref": "#/$defs/ResolutionStatus" },
        "product_id": { "type": ["string", "null"], "maxLength": 128 },
        "sku_id": { "type": ["string", "null"], "maxLength": 128 },
        "product_candidate_ids": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "sku_candidate_ids": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ResolutionAuditList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items", "total"],
      "properties": {
        "schema_version": { "const": "ai-cs.store-context.v1" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ResolutionAudit" } },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "request_id"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "AUTHENTICATION_REQUIRED", "AUTHENTICATION_FAILED", "SESSION_EXPIRED",
                "PASSWORD_CHANGE_REQUIRED", "AUTHORIZATION_DENIED", "DEFAULT_STORE_REQUIRED",
                "STORE_CONTEXT_UNAVAILABLE", "PRODUCT_CONFIRMATION_INVALID",
                "SKU_CONFIRMATION_INVALID", "RESOLUTION_NOT_FOUND", "RESOLUTION_NOT_READY",
                "VALIDATION_ERROR", "AI_SERVICE_UNAVAILABLE", "AI_SERVICE_REQUEST_REJECTED", "INTERNAL_ERROR"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "details": {}
          }
        },
        "request_id": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/DefaultStoreRequest" },
    { "$ref": "#/$defs/WorkspaceContextResponse" },
    { "$ref": "#/$defs/ResolutionRequest" },
    { "$ref": "#/$defs/ResolutionResponse" },
    { "$ref": "#/$defs/ResolutionAuditList" },
    { "$ref": "#/$defs/ErrorEnvelope" }
  ]
}
