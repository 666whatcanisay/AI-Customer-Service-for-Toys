{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cs.local/contracts/identity-access-management.v1.schema.json",
  "title": "AI-CS Identity and Access Management V1",
  "description": "Additive browser-user authentication, RBAC, store binding, and user-administration objects owned by the C Platform API.",
  "$defs": {
    "RoleName": {
      "type": "string",
      "enum": ["ADMIN", "OPERATOR", "CUSTOMER_SERVICE"]
    },
    "UserStatus": {
      "type": "string",
      "enum": ["ACTIVE", "DISABLED"]
    },
    "Permission": {
      "type": "string",
      "enum": [
        "workspace.access",
        "ai.reply",
        "feedback.submit",
        "customer_service.manage",
        "product.manage",
        "sku.manage",
        "knowledge.manage",
        "faq.manage",
        "ai_quality.view",
        "store.view",
        "feedback.view",
        "user.manage"
      ]
    },
    "StoreBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "store_id", "store_code", "store_name", "platform", "is_default"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "store_id": { "type": "integer", "minimum": 1 },
        "store_code": { "type": "string", "minLength": 1, "maxLength": 96 },
        "store_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
        "is_default": { "type": "boolean" }
      }
    },
    "UserProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "username", "display_name", "status", "roles", "permissions",
        "stores", "must_change_password", "all_store_access", "created_at", "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "NFKC-normalized Unicode letters/numbers plus dot, underscore, or hyphen; uniqueness and login matching use NFKC plus casefold."
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "$ref": "#/$defs/UserStatus" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/RoleName" }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Permission" }
        },
        "stores": {
          "type": "array",
          "items": { "$ref": "#/$defs/StoreBinding" }
        },
        "must_change_password": { "type": "boolean" },
        "all_store_access": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "LoginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string", "minLength": 1, "maxLength": 64 },
        "password": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "LoginResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "token_type", "access_token", "expires_at", "user"],
      "properties": {
        "schema_version": { "const": "ai-cs.iam.v1" },
        "token_type": { "const": "Bearer" },
        "access_token": { "type": "string", "minLength": 32, "maxLength": 128 },
        "expires_at": { "type": "string", "format": "date-time" },
        "user": { "$ref": "#/$defs/UserProjection" }
      }
    },
    "CurrentUserResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "user"],
      "properties": {
        "schema_version": { "const": "ai-cs.iam.v1" },
        "user": { "$ref": "#/$defs/UserProjection" }
      }
    },
    "UserCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "password", "display_name", "roles", "store_bindings"],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Unicode letters/numbers plus dot, underscore, or hyphen; normalized by the server."
        },
        "password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "Temporary initialization credential; the created user must change it before business API use."
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/RoleName" }
        },
        "store_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["store_id", "is_default"],
            "properties": {
              "store_id": { "type": "integer", "minimum": 1 },
              "is_default": { "type": "boolean" }
            }
          }
        }
      }
    },
    "UserUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "$ref": "#/$defs/UserStatus" },
        "password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "ADMIN reset credential; setting it restores must_change_password=true."
        }
      }
    },
    "ChangePasswordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_password", "new_password"],
      "properties": {
        "current_password": { "type": "string", "minLength": 1, "maxLength": 128 },
        "new_password": { "type": "string", "minLength": 12, "maxLength": 128 }
      }
    },
    "StoreOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "store_code", "store_name", "platform"],
      "properties": {
        "store_id": { "type": "integer", "minimum": 1 },
        "store_code": { "type": "string", "minLength": 1, "maxLength": 96 },
        "store_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "StoreOptionListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items"],
      "properties": {
        "schema_version": { "const": "ai-cs.iam.v1" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/StoreOption" } }
      }
    },
    "SelfStoreBindingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_ids"],
      "properties": {
        "store_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "RoleAssignmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/RoleName" }
        }
      }
    },
    "StoreBindingAssignmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_bindings"],
      "properties": {
        "store_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["store_id", "is_default"],
            "properties": {
              "store_id": { "type": "integer", "minimum": 1 },
              "is_default": { "type": "boolean" }
            }
          }
        }
      }
    },
    "UserListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items", "total"],
      "properties": {
        "schema_version": { "const": "ai-cs.iam.v1" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/UserProjection" } },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "request_id"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "AUTHENTICATION_REQUIRED", "AUTHENTICATION_FAILED", "SESSION_EXPIRED",
                "PASSWORD_CHANGE_REQUIRED", "AUTHORIZATION_DENIED", "USER_NOT_FOUND", "USERNAME_CONFLICT",
                "ROLE_INVALID", "STORE_BINDING_INVALID", "DEFAULT_STORE_REQUIRED",
                "VALIDATION_ERROR", "INTERNAL_ERROR"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "details": {}
          }
        },
        "request_id": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/LoginRequest" },
    { "$ref": "#/$defs/LoginResponse" },
    { "$ref": "#/$defs/CurrentUserResponse" },
    { "$ref": "#/$defs/UserCreateRequest" },
    { "$ref": "#/$defs/UserUpdateRequest" },
    { "$ref": "#/$defs/ChangePasswordRequest" },
    { "$ref": "#/$defs/StoreOptionListResponse" },
    { "$ref": "#/$defs/SelfStoreBindingRequest" },
    { "$ref": "#/$defs/RoleAssignmentRequest" },
    { "$ref": "#/$defs/StoreBindingAssignmentRequest" },
    { "$ref": "#/$defs/UserListResponse" },
    { "$ref": "#/$defs/ErrorEnvelope" }
  ]
}
