LLM_PROVIDER=ollama
DASHSCOPE_API_KEY=
LLM_MODEL=qwen3.5:9b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TOP_P=0.8

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_OFFLINE=true
CHUNK_SIZE=500
CHUNK_OVERLAP=100
KNOWLEDGE_BASE_PATH=./knowledge_base
VECTOR_DB_PATH=./vector_db
CHROMA_COLLECTION_NAME=documents
TEST_KNOWLEDGE_COLLECTION_NAME=test_knowledge_v031
# Runtime/OPS uses this configured queryable collection for readiness and smoke checks.
ACTIVE_COLLECTION_NAME=test_knowledge_v031

PLATFORM_API_BASE_URL=
PLATFORM_API_TIMEOUT_SECONDS=30
# Optional trace label for explicit customer-experience evaluations.
EXPERIENCE_EVALUATION_PROMPT_VERSION=experience-evaluation-v1
# Optional trace label for explicit C feedback analysis evidence.
FEEDBACK_ANALYSIS_PROMPT_VERSION=ai-quality-feedback-v1
# Optional trace label for explicit C-approved product-material quality analysis.
KNOWLEDGE_QUALITY_PROMPT_VERSION=knowledge-quality.v1

RAG_DISTANCE_THRESHOLD=0.6
TOP_K=2

# Comma-separated explicit browser Origins. Whitespace around entries is ignored.
# Every Origin must be http(s)://host[:port], without path, query, or fragment.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

HOST=127.0.0.1
PORT=8000

# Channel Engine Gateway is opt-in. Standard/shadow/recovery runtime modes require
# a UTF-8 single-line secret file reference; never put the secret value here.
AI_CS_SERVER_RUNTIME_MODE=standard
GATEWAY_ENABLED=false
GATEWAY_CLIENT_ID=channel-engine
GATEWAY_KEY_ID=gateway-key-v1
GATEWAY_HMAC_SECRET_FILE=
GATEWAY_STATE_PATH=./gateway_state.sqlite3
GATEWAY_CLOCK_SKEW_SECONDS=300
GATEWAY_NONCE_TTL_SECONDS=600
GATEWAY_DECISION_RETENTION_SECONDS=604800
GATEWAY_DECISION_LEASE_SECONDS=30
