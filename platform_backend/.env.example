PLATFORM_APP_NAME=Mumu Platform Backend
PLATFORM_SERVICE_NAME=platform-backend
PLATFORM_VERSION=0.1.0
PLATFORM_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=sqlite:///./platform.db
PLATFORM_MAX_UPLOAD_BYTES=5242880
PLATFORM_MAX_IMPORT_ROWS=1000
PLATFORM_MAX_TEST_PACKAGE_UPLOAD_BYTES=33554432
PLATFORM_MAX_TEST_PACKAGE_ENTRIES=100
PLATFORM_MAX_TEST_PACKAGE_UNCOMPRESSED_BYTES=67108864
PLATFORM_MAX_TEST_PACKAGE_SINGLE_FILE_BYTES=20971520
IAM_SESSION_TTL_MINUTES=480
IAM_LOGIN_MAX_FAILURES=5
IAM_LOGIN_WINDOW_SECONDS=900
IAM_LOGIN_COOLDOWN_SECONDS=900
IAM_MAX_ACTIVE_SESSIONS=5
KNOWLEDGE_PUBLICATION_LEASE_SECONDS=300
# Shared A/C service identity file (ASCII, one line, 32+ bytes). Never inline.
INTERNAL_SERVICE_SECRET_FILE=
