@{
    RepositoryRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
    RagPythonPath = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'backend\.venv\Scripts\python.exe')
    PlatformPythonPath = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'platform_backend\.venv\Scripts\python.exe')
    PnpmCommand = 'pnpm.cmd'
    RagPort = 8000; CustomerWebPort = 5173; PlatformPort = 8011; BindAddress = '127.0.0.1'
    CustomerWebUrl = 'http://127.0.0.1:5173/'
    RagHealthPath = '/api/health'; PlatformHealthPath = '/health'
    OllamaModel = 'qwen3.5:9b'
    OllamaBaseUrl = 'http://127.0.0.1:11434'
    PlatformDatabaseUrl = 'sqlite:///./platform.db'
    TestKnowledgePackageId = 'PDD-SM-2026-001-TEST'
    AutoSyncTestKnowledge = $true
    CorsAllowedOrigins = @('http://127.0.0.1:5173')
    OpenBrowser = $true
    RuntimeDirectory = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path '.runtime')
    TestDataPackagePath = ''
    AutoImportTestData = $false
    # 本机入口保持本机模式；“启动局域网客服.bat”会显式启用 LAN 模式。
    LanMode = $false
    # 局域网模式固定监听所有本机接口，但只公布经校验的私有 IPv4。
    LanBindAddress = '0.0.0.0'
    # 留空时只在恰好一个有效物理网卡 IPv4 时自动选择；多网卡时必须显式填写。
    LanAdvertisedHost = ''
    # Public 网络默认阻止。仅在明确理解风险后才可改为 $true，脚本不会修改防火墙。
    AllowPublicNetwork = $false
}
