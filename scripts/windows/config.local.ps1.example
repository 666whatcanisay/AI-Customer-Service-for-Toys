@{
    # 发布运行角色与网络暴露分离。正式端口使用 standard；影子环境使用 shadow。
    RuntimeMode = 'standard'
    RepositoryRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
    # A Core always stays on BindAddress/RagPort. LAN Gateway uses a separate edge.
    GatewayEnabled = $false
    GatewayClientId = 'channel-engine'
    GatewayKeyId = 'gateway-key-v1'
    # Reference only. Create this ignored runtime file as one UTF-8 line (32+ bytes).
    GatewaySecretReference = 'secrets\gateway-hmac.secret'
    # Separate service identity for A<->C loopback calls; do not reuse Gateway HMAC.
    InternalServiceSecretReference = 'secrets\internal-service.secret'
    # LAN Runtime requires both files and serves Customer Web over HTTPS. Keep
    # the private key below RuntimeDirectory and outside Git.
    CustomerWebTlsCertificateReference = 'secrets\customer-web.crt'
    CustomerWebTlsKeyReference = 'secrets\customer-web.key'
    GatewayStatePath = 'gateway\gateway_state.sqlite3'
    GatewayClockSkewSeconds = 300
    GatewayNonceTtlSeconds = 600
    GatewayDecisionRetentionSeconds = 604800
    GatewayDecisionLeaseSeconds = 30
    # Gateway LAN edge: explicit private adapter address or auto; never 0.0.0.0.
    GatewayLanBindAddress = 'auto'
    GatewayLanPort = 18080
    # auto resolves to the selected physical adapter subnet. Explicit entries
    # must be canonical RFC1918 CIDRs contained by that subnet.
    GatewayAllowedNetworks = @('auto')
    GatewayUpstreamTimeoutSeconds = 180
    # 客服电脑接入默认关闭。启用时仅填写 Channel Engine 地址和 RuntimeDirectory
    # 内的会话引用文件路径；不要把不透明会话值写进此配置。
    ChannelAgentIntegrationEnabled = $false
    ChannelAgentServerUrl = ''
    ChannelAgentOperatorSessionReference = 'secrets\channel-agent-operator.session'
    ChannelAgentTimeoutSeconds = 5
    RagPythonPath = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'backend\.venv\Scripts\python.exe')
    PlatformPythonPath = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'platform_backend\.venv\Scripts\python.exe')
    # Used only by build/CI tooling. Production Runtime serves prebuilt dist assets.
    PnpmCommand = 'pnpm.cmd'
    RagPort = 8000; CustomerWebPort = 5173; PlatformPort = 8011; BindAddress = '127.0.0.1'
    CustomerWebUrl = 'http://127.0.0.1:5173/'
    # 管理后台默认只绑定服务器本机。即使显式开启 LAN 模式，本轮也不会修改防火墙。
    AdminWebPort = 5174
    AdminWebBindAddress = '127.0.0.1'
    AdminWebUrl = 'http://127.0.0.1:5174/'
    AdminEnableLanMode = $false
    AdminOpenBrowser = $false
    RagHealthPath = '/api/health'; PlatformHealthPath = '/health'
    OllamaModel = 'qwen3.5:9b'
    OllamaBaseUrl = 'http://127.0.0.1:11434'
    # Production startup requires an explicit absolute database plus an
    # internal/sidecar identity binding. Create or upgrade it only through
    # Invoke-PlatformControlledMigration.ps1.
    PlatformDatabaseUrl = 'sqlite:///C:/absolute/path/to/platform.sqlite3'
    PlatformDatabaseBindingPath = 'C:\absolute\path\to\platform.binding.json'
    PlatformDatabaseEnvironmentId = 'AI_CS_STANDARD'
    PlatformRequireDatabaseIdentity = $true
    # A运行路径和active collection由本配置统一提供；启动脚本不再依赖调用终端预先设置环境变量。
    RagKnowledgeBasePath = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'backend\knowledge_base')
    RagVectorDbPath = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'backend\vector_db')
    RagLogDirectory = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'logs')
    RagPrimaryCollectionName = 'documents'
    RagActiveCollectionName = 'test_knowledge_v031'
    PlatformKnowledgeMaterialStorageDirectory = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path 'platform_backend\.runtime\knowledge-materials')
    TestKnowledgePackageId = 'PDD-SM-2026-001-TEST'
    AutoSyncTestKnowledge = $true
    CorsAllowedOrigins = @('http://127.0.0.1:5173')
    OpenBrowser = $true
    RuntimeDirectory = (Join-Path (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path '.runtime')
    TestDataPackagePath = ''
    AutoImportTestData = $false
    # “启动局域网客服.bat”每次会重新选择局域网地址，避免切换网线或手机热点后沿用旧 IP。
    EnableLanMode = $false
    # auto：只选状态为 Up、拥有私有 IPv4 和默认网关的物理网卡；以太网优先于 WLAN。
    # 也可填写当前有效 IPv4；不要填写 VPN、WSL 或虚拟网卡地址。
    LanAddress = 'auto'
    # 只有多个同优先级物理网卡时才需要填写，例如 'Ethernet' 或 'Wi-Fi'。
    PreferredInterfaceAlias = ''
    # 以下两个字段仅为旧版 ignored config.local.ps1 的兼容保留；新版 LAN 启动不再使用它们。
    LanMode = $false
    LanBindAddress = '0.0.0.0'
    LanAdvertisedHost = ''
    # Public 网络默认阻止。仅在明确理解风险后才可改为 $true，脚本不会修改防火墙。
    AllowPublicNetwork = $false
}
